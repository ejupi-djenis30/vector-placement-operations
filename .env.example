# npm start reads this file through Node's built-in environment-file loader.
NODE_ENV=production

# Public URL used by browsers. Production startup requires HTTPS, even when the internal listener
# or published port is loopback-only behind a host-level TLS proxy.
VECTOR_ORIGIN=

# Compose publishes the application on loopback by default for a host-level TLS proxy.
VECTOR_BIND_ADDRESS=127.0.0.1
VECTOR_PUBLISHED_PORT=4173

# These values are pinned by compose.yaml and are listed here for non-Compose deployments.
VECTOR_HOST=127.0.0.1
VECTOR_PORT=4173
VECTOR_DB_PATH=./data/vector.sqlite

# Used only for the one-shot initialization of an empty database.
# Production initialization exits after creating the school and administrator. Remove this
# value before restarting VECTOR to serve users. There is deliberately no default password.
VECTOR_BOOTSTRAP_SCHOOL_NAME=
VECTOR_BOOTSTRAP_SCHOOL_SLUG=
# IANA time zone used to decide the school's current date for entries and check-ins.
VECTOR_BOOTSTRAP_TIME_ZONE=
VECTOR_BOOTSTRAP_ADMIN_EMAIL=
VECTOR_BOOTSTRAP_ADMIN_NAME=
VECTOR_BOOTSTRAP_ADMIN_PASSWORD=

# Secure cookies are mandatory in production. Forwarded headers are untrusted by default; set the
# proxy hop count only after placing VECTOR behind that exact number of controlled proxies.
VECTOR_COOKIE_SECURE=true
VECTOR_TRUST_PROXY=false

# Synthetic records are for evaluation environments, never a real installation.
VECTOR_SEED_SYNTHETIC=false

# Optional operational limits.
VECTOR_BODY_LIMIT=524288
# Hard ceiling for backup creation, inspection and restore input (default and maximum 10 GiB).
VECTOR_BACKUP_MAX_BYTES=10737418240
# Bound slow or stuck HTTP clients and keep shutdown behaviour predictable.
VECTOR_REQUEST_TIMEOUT_MS=30000
VECTOR_HEADERS_TIMEOUT_MS=10000
VECTOR_KEEP_ALIVE_TIMEOUT_MS=5000
VECTOR_MAX_REQUESTS_PER_SOCKET=1000
VECTOR_SHUTDOWN_GRACE_MS=10000
# Absolute session lifetime and server-enforced inactivity timeout.
# The inactivity timeout must be at least 5 minutes and no longer than the absolute lifetime.
VECTOR_SESSION_HOURS=12
VECTOR_SESSION_IDLE_MINUTES=45
VECTOR_LOG_LEVEL=info
